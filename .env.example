# Pooled Postgres connection string. Neon: use the -pooler host.
# Transactions are required (project write + audit entry are atomic),
# so the Neon HTTP driver is NOT usable here. This app uses node-postgres.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Any 32+ char random string. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-a-random-32-byte-string"
BETTER_AUTH_URL="http://localhost:3000"

# Password used for all three seeded test accounts (dev/test only).
SEED_PASSWORD="TenantDesk!2026"
